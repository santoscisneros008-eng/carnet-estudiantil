# Copia este archivo como ".env" y coloca aquí los datos reales
# que Aiven te da en la pestaña "Connection information" de tu servicio PostgreSQL.

PGHOST=tu-servicio-pg.aivencloud.com
PGPORT=12345
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=tu_password_de_aiven
PGSSLMODE=require

# Puerto en el que correrá Flask en tu PC de Windows
FLASK_PORT=5000

# Nombre de la institución que se muestra en el carné (opcional)
NOMBRE_INSTITUCION=Instituto Nacional Ejemplo

# Contraseña para entrar al panel de administración (/admin) y dar de
# alta estudiantes desde el formulario web. Cámbiala por una tuya.
ADMIN_PASSWORD=cambia-esta-clave

# Clave secreta interna de Flask (para las sesiones de administración).
# Pon cualquier texto largo y aleatorio, no tiene que ser memorable.
FLASK_SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio
